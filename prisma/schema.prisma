generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  memberships    TeamMembership[]
  players        Player[]
  invitesCreated Invite[]             @relation("InviteCreator")
  resetTokens    PasswordResetToken[]
  auditLogs      AuditLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Teams ----------

enum TeamRole {
  CAPTAIN
  MEMBER
}

enum Gender {
  F
  M
}

enum InviteChannel {
  EMAIL
  WHATSAPP
  LINK
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  memberships  TeamMembership[]
  players      Player[]
  invites      Invite[]
  seasons      SeasonTeam[]
  homeFixtures Fixture[]        @relation("HomeTeam")
  awayFixtures Fixture[]        @relation("AwayTeam")
}

model TeamMembership {
  userId    String
  teamId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model Invite {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  teamId      String
  role        TeamRole      @default(MEMBER)
  channel     InviteChannel @default(LINK)
  email       String?
  phone       String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime      @default(now())

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("InviteCreator", fields: [createdById], references: [id])
}

model Player {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  gender    Gender
  userId    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  team    Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  matches MatchPlayer[]

  @@unique([teamId, name])
}

// ---------- Schedule ----------

enum Slot {
  EARLY // 19:00 + 21:00
  LATE // 20:00 + 22:00
}

enum MatchType {
  MIXED
  LADIES
  MEN
}

enum MatchStatus {
  OPEN
  SUBMITTED
  APPROVED
  DISPUTED
}

enum Side {
  HOME
  AWAY
}

model Season {
  id        String   @id @default(cuid())
  name      String
  courts    Int      @default(4)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  teams    SeasonTeam[]
  evenings Evening[]
}

model SeasonTeam {
  seasonId String
  teamId   String

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([seasonId, teamId])
}

model Evening {
  id       String   @id @default(cuid())
  seasonId String
  date     DateTime @db.Date

  season   Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  fixtures Fixture[]

  @@unique([seasonId, date])
}

model Fixture {
  id         String   @id @default(cuid())
  eveningId  String
  homeTeamId String
  awayTeamId String
  slot       Slot
  createdAt  DateTime @default(now())

  evening  Evening @relation(fields: [eveningId], references: [id], onDelete: Cascade)
  homeTeam Team    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  matches  Match[]
}

model Match {
  id                String      @id @default(cuid())
  fixtureId         String
  type              MatchType
  number            Int // 1..8, order within the fixture
  block             Int // 1 = before the break, 2 = after
  status            MatchStatus @default(OPEN)
  submittedByTeamId String?
  submittedByUserId String?
  submittedAt       DateTime?
  approvedByUserId  String?
  approvedAt        DateTime?
  disputeComment    String?

  fixture Fixture       @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  players MatchPlayer[]
  sets    MatchSet[]

  @@unique([fixtureId, number])
}

model MatchPlayer {
  matchId  String
  side     Side
  position Int // 1 or 2
  playerId String

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@id([matchId, side, position])
}

model MatchSet {
  matchId   String
  setNo     Int // 1..3
  played    Boolean @default(true)
  homeGames Int     @default(0)
  awayGames Int     @default(0)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, setNo])
}

// ---------- Security ----------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model RateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
}
